# Copy this file to .env and fill in your real key. Never commit .env itself.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used for all LLM calls in this repo
ANTHROPIC_MODEL=claude-sonnet-4-6

# Set to "1" to force deterministic/offline mock mode (no API calls, rule-based fallback)
# Useful for CI and for reviewers without an API key.
MOCK_MODE=0
